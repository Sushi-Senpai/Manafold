PORT=8080

# Required. Startup fails naming whichever of these is unset or empty
# (internal/config, PLATFORM-003).
DATABASE_URL=postgres://manafold:manafold@localhost:5432/manafold?sslmode=disable
FRONTEND_URL=http://localhost:3000

# Set to true to sign every /api request in as one fixed local-dev user
# (internal/middleware/devauth.go) instead of a real session. Off by default;
# never set in production. M1 runs on this stub only — the real email +
# password login flow is M3 (see docs/intent/account-access/).
DEV_AUTH=true

# Required from M4 (no AI code ships in M1). Developer-held Anthropic key —
# not bring-your-own-key. See docs/intent/ai-assist/.
ANTHROPIC_API_KEY=

# Number of reverse proxies in front of this API that append the client address
# to X-Forwarded-For. The per-IP auth rate limiter (ACCT-017) reads its key that
# many hops from the right of the chain, so a caller cannot bypass it by
# prepending a forged entry. Defaults to 1 (Render's own edge). It MUST be set
# to the deployed Vercel-rewrite + Render stack's true hop count — likely 2 if
# the Next.js rewrite also appends X-Forwarded-For — and verified before the
# credential-stuffing / signup-spam guard is relied on in production. A
# non-numeric or negative value falls back to 1. See
# docs/intent/account-access/account-access-design.md § Rate limiting.
TRUSTED_PROXY_COUNT=1
