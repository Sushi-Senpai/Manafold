PORT=8080
DATABASE_URL=postgres://manafold:manafold@localhost:5432/manafold?sslmode=disable
FRONTEND_URL=http://localhost:3000

# Set to true to sign every /api request in as one fixed local-dev user
# (internal/middleware/devauth.go) instead of a real session. Off by default;
# never set in production. M1 runs on this stub only — the real email +
# password login flow is M3 (see docs/intent/account-access/).
DEV_AUTH=true

# Required from M4 (no AI code ships in M1). Developer-held Anthropic key —
# not bring-your-own-key. See docs/intent/ai-assist/.
ANTHROPIC_API_KEY=
